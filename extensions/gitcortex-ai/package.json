{
  "name": "gitcortex-ai",
  "displayName": "GitCortex AI",
  "description": "The GitCortex AI agent — an AI-native assistant that can plan, edit files, run terminal commands, run tests, and deploy, driving real software work. OpenHands-compatible.",
  "version": "0.1.0",
  "publisher": "gitcortex",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Machine Learning"],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitcortex.ai.open",
    "onView:gitcortex.ai.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitcortex-ai",
          "title": "GitCortex AI",
          "icon": "resources/ai.svg"
        }
      ]
    },
    "views": {
      "gitcortex-ai": [
        {
          "id": "gitcortex.ai.chat",
          "type": "webview",
          "name": "GitCortex AI",
          "icon": "resources/ai.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "gitcortex.ai.open",
        "title": "GitCortex: Open AI",
        "category": "GitCortex AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitcortex.ai.send",
        "title": "GitCortex AI: Send",
        "category": "GitCortex AI"
      },
      {
        "command": "gitcortex.ai.clear",
        "title": "GitCortex AI: Clear Conversation",
        "category": "GitCortex AI",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitcortex.ai.runFile",
        "title": "GitCortex AI: Run on Current File",
        "category": "GitCortex AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitcortex.ai.explainSelection",
        "title": "GitCortex AI: Explain Selection",
        "category": "GitCortex AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitcortex.ai.refactorSelection",
        "title": "GitCortex AI: Refactor Selection",
        "category": "GitCortex AI",
        "icon": "$(wand)"
      },
      {
        "command": "gitcortex.ai.generateFromComment",
        "title": "GitCortex AI: Generate from Comment",
        "category": "GitCortex AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitcortex.ai.fixProblems",
        "title": "GitCortex AI: Fix Problems in File",
        "category": "GitCortex AI",
        "icon": "$(bug)"
      },
      {
        "command": "gitcortex.ai.runTests",
        "title": "GitCortex AI: Run Tests",
        "category": "GitCortex AI",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "gitcortex.ai.open" },
        { "command": "gitcortex.ai.clear" },
        { "command": "gitcortex.ai.runFile", "when": "editorIsOpen" },
        { "command": "gitcortex.ai.explainSelection", "when": "editorHasSelection" },
        { "command": "gitcortex.ai.refactorSelection", "when": "editorHasSelection" },
        { "command": "gitcortex.ai.generateFromComment", "when": "editorIsOpen" },
        { "command": "gitcortex.ai.fixProblems", "when": "editorIsOpen" },
        { "command": "gitcortex.ai.runTests" }
      ],
      "editor/context": [
        {
          "command": "gitcortex.ai.explainSelection",
          "when": "editorHasSelection",
          "group": "gitcortex@1"
        },
        {
          "command": "gitcortex.ai.refactorSelection",
          "when": "editorHasSelection",
          "group": "gitcortex@2"
        },
        {
          "command": "gitcortex.ai.runFile",
          "when": "editorFocus",
          "group": "gitcortex@3"
        },
        {
          "command": "gitcortex.ai.generateFromComment",
          "when": "editorFocus",
          "group": "gitcortex@4"
        },
        {
          "command": "gitcortex.ai.fixProblems",
          "when": "editorFocus",
          "group": "gitcortex@5"
        }
      ],
      "editor/title": [
        {
          "command": "gitcortex.ai.open",
          "when": "editorIsOpen",
          "group": "navigation@99"
        }
      ],
      "explorer/context": [
        {
          "command": "gitcortex.ai.runFile",
          "group": "gitcortex@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitcortex.ai.open",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus || editorFocus"
      },
      {
        "command": "gitcortex.ai.explainSelection",
        "key": "ctrl+shift+g e",
        "mac": "cmd+shift+g e",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "gitcortex.ai.refactorSelection",
        "key": "ctrl+shift+g r",
        "mac": "cmd+shift+g r",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "gitcortex.ai.send",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "gitcortex.ai.chatFocused"
      }
    ],
    "configuration": {
      "title": "GitCortex AI",
      "properties": {
        "gitcortex.ai.transport": {
          "type": "string",
          "enum": ["ahp", "openhands", "openai-compatible"],
          "default": "ahp",
          "description": "Agent transport. 'ahp' (default) uses the engine's native Agent Host Protocol — the same server that powers the built-in AI. 'openhands'/'openai-compatible' connect to a remote runtime via gitcortex.ai.endpoint."
        },
        "gitcortex.ai.endpoint": {
          "type": "string",
          "default": "",
          "description": "Endpoint URL for the AI transport (e.g. the OpenHands agent runtime URL)."
        },
        "gitcortex.ai.autonomy": {
          "type": "string",
          "enum": ["confirm", "auto-files", "auto-all"],
          "default": "confirm",
          "description": "Autonomy level for destructive tools (file write, terminal, deploy)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Frankenstein-dev197/GitCortex-Studio",
    "directory": "extensions/gitcortex-ai"
  }
}
