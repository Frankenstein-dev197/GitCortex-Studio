  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#64748b", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#86efac" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#fbbf24" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#fbbf24" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#8b5cf6" } },
    { "scope": ["keyword.control"], "settings": { "foreground": "#a78bfa" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#60a5fa" } },
    { "scope": ["entity.name.class", "entity.name.type", "support.type"], "settings": { "foreground": "#a78bfa" } },
    { "scope": ["entity.name.type.interface"], "settings": { "foreground": "#34d399" } },
    { "scope": ["entity.name.enum"], "settings": { "foreground": "#fbbf24" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#e2e8f0" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#e2e8f0" } },
    { "scope": ["variable.other.property"], "settings": { "foreground": "#7dd3fc" } },
    { "scope": ["entity.name.namespace"], "settings": { "foreground": "#f472b6" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#94a3b8" } },
    { "scope": ["meta.tag", "entity.name.tag"], "settings": { "foreground": "#f472b6" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#fbbf24" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#a78bfa", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#22c55e" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ef4444" } }
  ]
}
