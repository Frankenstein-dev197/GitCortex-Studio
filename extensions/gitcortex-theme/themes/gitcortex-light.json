{
  "name": "gitcortex-light",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#1e293b",
    "function": "#2563eb",
    "type": "#7c3aed",
    "class": "#7c3aed",
    "interface": "#059669",
    "enum": "#d97706",
    "namespace": "#db2777",
    "keyword": "#7c3aed",
    "string": "#16a34a",
    "number": "#d97706",
    "comment": "#64748b"
  },
  "colors": {
    "editor.background": "#f8fafc",
    "editor.foreground": "#1e293b",
    "editorLineNumber.foreground": "#cbd5e1",
    "editorLineNumber.activeForeground": "#475569",
    "editorCursor.foreground": "#2563eb",
    "editor.selectionBackground": "#dbeafe",
    "editor.lineHighlightBackground": "#f1f5f9",
    "editorIndentGuide.background1": "#e2e8f0",
    "editorIndentGuide.activeBackground1": "#2563eb",
    "editorWidget.background": "#f1f5f9",
    "editorWidget.border": "#e2e8f0",
    "activityBar.background": "#f8fafc",
    "activityBar.foreground": "#475569",
    "activityBar.activeBorder": "#2563eb",
    "activityBarBadge.background": "#2563eb",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#f8fafc",
    "sideBar.foreground": "#334155",
    "sideBarTitle.foreground": "#1e293b",
    "list.activeSelectionBackground": "#dbeafe",
    "list.activeSelectionForeground": "#1e293b",
    "list.inactiveSelectionBackground": "#f1f5f9",
    "list.hoverBackground": "#f1f5f9",
    "statusBar.background": "#f8fafc",
    "statusBar.foreground": "#475569",
    "statusBarItem.remoteBackground": "#7c3aed",
    "statusBarItem.remoteForeground": "#ffffff",
    "titleBar.activeBackground": "#f8fafc",
    "titleBar.activeForeground": "#1e293b",
    "tab.activeBackground": "#f8fafc",
    "tab.activeForeground": "#1e293b",
    "tab.activeBorderTop": "#2563eb",
    "tab.inactiveBackground": "#f8fafc",
    "tab.inactiveForeground": "#94a3b8",
    "panel.background": "#f8fafc",
    "panel.border": "#e2e8f0",
    "terminal.background": "#f8fafc",
    "terminal.foreground": "#1e293b",
    "button.background": "#2563eb",
    "button.foreground": "#ffffff",
    "focusBorder": "#2563eb88",
    "foreground": "#1e293b",
    "gitcortex.aiAccent": "#7c3aed",
    "gitcortex.aiBackground": "#ede9fe"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#64748b", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "#16a34a" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#d97706" } },
    { "scope": ["keyword", "storage.type"], "settings": { "foreground": "#7c3aed" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#2563eb" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#7c3aed" } },
    { "scope": ["entity.name.type.interface"], "settings": { "foreground": "#059669" } },
    { "scope": ["variable"], "settings": { "foreground": "#1e293b" } },
    { "scope": ["entity.name.namespace"], "settings": { "foreground": "#db2777" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#7c3aed", "fontStyle": "bold" } }
  ]
}
